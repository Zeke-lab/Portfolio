generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContentStatus {
  draft
  published
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id           String        @id @default(cuid())
  fullName     String
  headline     String?
  intro        String?
  about        String?
  location     String?
  email        String?       @unique
  phone        String?
  avatarUrl    String?
  resumePhotoUrl String?
  availability String?
  featured     Boolean       @default(false)
  status       ContentStatus @default(draft)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  socialLinks  SocialLink[]
  resumes      Resume[]
}

model SocialLink {
  id        String   @id @default(cuid())
  profileId String
  label     String
  url       String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id           String             @id @default(cuid())
  slug         String             @unique
  title        String
  subtitle     String
  summary      String?
  description  String?
  imageUrl     String?
  liveUrl      String?
  repoUrl      String?
  caseStudyLink String?
  featured     Boolean            @default(false)
  status       ContentStatus      @default(draft)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  technologies ProjectTechnology[]
  caseStudy    CaseStudy?
  gallery      ProjectGallery[]

  @@index([featured])
  @@index([status])
}

model ProjectTechnology {
  id        String   @id @default(cuid())
  projectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model CaseStudy {
  id             String        @id @default(cuid())
  projectId      String        @unique
  problem        String?
  approach       String?
  solution       String?
  implementation String?
  execution      String?
  results        String?
  status         ContentStatus @default(draft)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features       CaseStudyFeature[]
}

model CaseStudyFeature {
  id          String   @id @default(cuid())
  caseStudyId String
  title       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)

  @@index([caseStudyId, order])
}

model ProjectGallery {
  id        String   @id @default(cuid())
  projectId String
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

model Skill {
  id         String        @id @default(cuid())
  category   String
  name       String
  icon       String?
  featured   Boolean       @default(false)
  status     ContentStatus @default(draft)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([category])
  @@index([featured])
  @@index([status])
}

model Experience {
  id          String              @id @default(cuid())
  company     String
  role        String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String
  featured    Boolean             @default(false)
  status      ContentStatus       @default(draft)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  bullets     ExperienceBullet[]

  @@index([featured])
  @@index([status])
}

model ExperienceBullet {
  id           String      @id @default(cuid())
  experienceId String
  text         String
  order        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  experience   Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model Education {
  id          String        @id @default(cuid())
  institution String
  degree      String?
  field       String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  description String?
  featured    Boolean       @default(false)
  status      ContentStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([featured])
  @@index([status])
}

model Certification {
  id            String        @id @default(cuid())
  title         String
  issuer        String
  year          String?
  issuedAt      DateTime?
  credentialUrl String?
  featured      Boolean       @default(false)
  status        ContentStatus @default(draft)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([featured])
  @@index([status])
}

model Resume {
  id          String        @id @default(cuid())
  profileId   String
  label       String        @default("Resume")
  url         String
  fileName    String?
  mimeType    String?
  featured    Boolean       @default(false)
  status      ContentStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  profile     Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([featured])
  @@index([status])
}

model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  subject     String?
  message     String
  status      ContentStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([email])
  @@index([status])
}
